# Copy to .env and fill in. .env is gitignored — keep it that way.

# LLM routing (first match wins)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
GITLAWB=ogw_live_your_key_here
GITLAWB_MODEL=mimo-v2.5-pro

# Helius DAS (free key at helius.dev) — realtime stats + prices + RPC
HELIUS_API_KEY=

# Wallet
# WALLET_KEYPAIR=~/.config/solana/id.json
# WALLET_ADDRESS=

# Burn policy
BURN_MAX_USD=5
BURN_COOLDOWN_SEC=60
# BURN_ALLOW_UNPRICED=1   # allow burning mints DAS can't price (cap unenforceable)
